{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content/schema-item.json",
  "title": "Item d'exercice",
  "description": "Format normalisé d'un item de contenu. Validation obligatoire avant intégration ; relecture orthophoniste tracée dans meta.relecture_ortho.",
  "type": "object",
  "required": [
    "id",
    "module",
    "theme",
    "type",
    "palier",
    "contenu"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Identifiant stable de l'item, ex. 'py-cmd-enumerate-01'."
    },
    "module": {
      "enum": [
        "entrainement",
        "reeducation",
        "bilan"
      ]
    },
    "theme": {
      "type": "string",
      "description": "ex. calcul-mental, anglais, python/concepts/bases, attention-soutenue…"
    },
    "type": {
      "enum": [
        "production",
        "qcm",
        "prediction-sortie",
        "restitution-errorless",
        "rt-continu",
        "empan",
        "n-back",
        "stroop",
        "trail-making",
        "multi-etapes",
        "paires-associatives",
        "empan-mots",
        "rappel-libre",
        "rappel-indice",
        "reconnaissance",
        "rappel-source",
        "prise-message",
        "etape-suivante",
        "estimation-temps",
        "par-ou-commencer",
        "si-alors",
        "meilleure-solution",
        "grille-deduction",
        "pqrst",
        "but-etapes",
        "auto-instruction",
        "analyse-mot",
        "plan-a-verifier",
        "reperer-info",
        "aide-externe",
        "gestion-du-temps",
        "pqrst-mise-en-oeuvre",
        "actualiser-consigne",
        "comparer-documents",
        "reperer-essentiel",
        "reprise-interrompue"
      ]
    },
    "fonctions_ciblees": {
      "type": "array",
      "items": {
        "enum": [
          "attention-soutenue",
          "attention-divisee",
          "attention-selective",
          "attention-alternee",
          "memoire-travail",
          "inhibition",
          "flexibilite",
          "planification",
          "vitesse-traitement",
          "automatisation",
          "memorisation-longue",
          "acces-lexical",
          "recuperation",
          "cognition-sociale",
          "pragmatique",
          "fonctions-executives",
          "memoire-prospective"
        ]
      }
    },
    "palier": {
      "type": "integer",
      "minimum": 1
    },
    "prerequis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Identifiants des items ou concepts prérequis (alimente le graphe de connaissances)."
    },
    "cap_complexite": {
      "type": [
        "string",
        "null"
      ],
      "description": "Justification pédagogique du cap, ex. '2 niveaux d imbrication max (phase initiale)'."
    },
    "contenu": {
      "type": "object",
      "description": "Corps de l'item, spécifique au type d'exercice. Champs conventionnels : enonce, consigne, aide, methode (stratégie facultative propre à l’item), options (liste de propositions pour les types à choix : reconnaissance, rappel-source, pqrst, etape-suivante… — la réponse attendue doit y figurer), indices (hiérarchie d'aides des items rappel-indice : [{type: semantique|phonologique|orthographique, texte}], jamais la réponse elle-même), document (texte permanent à consulter pendant la question pour reperer-info), affichage (phase de mémorisation temporisée : mode sequence|liste)."
    },
    "reponse": {
      "type": "object",
      "description": "Réponse attendue et tolérances (spécifique au type)."
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auteur": {
          "type": "string"
        },
        "date_creation": {
          "type": "string",
          "format": "date"
        },
        "relecture_ortho": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "statut": {
              "enum": [
                "a_revoir",
                "relecture_en_cours",
                "valide_informel"
              ]
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "commentaire": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
